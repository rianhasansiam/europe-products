generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ==========================================================================
 * Users & authentication
 * ==========================================================================
 */

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String?
  phone    String?
  city     String?
  image    String?
  role     Role    @default(USER)
  preferredLocale String?

  provider        AuthProvider @default(CREDENTIAL)
  termsAcceptedAt DateTime?

  orders          Order[]
  cartItems       CartItem[]
  wishlists       Wishlist[]
  addresses       Address[]
  promoCodeUsages PromoCodeUsage[]
  reviews         Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, createdAt])
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  CREDENTIAL
  GOOGLE
}

// Available provider capabilities are cached separately from visitor publication.
model LocaleLanguage {
  code                String   @id
  englishName         String
  nativeName          String
  direction           String   @default("ltr")
  fallbackLocale      String?
  providerCode        String?
  // Directed model capabilities from LibreTranslate /languages, keyed by this source.
  providerTargets     Json?    @db.JsonB
  available           Boolean  @default(false)
  prepared            Boolean  @default(false)
  published           Boolean  @default(false)
  publicationOverride Boolean  @default(false)
  interfaceCatalog    Json?    @db.JsonB
  interfaceSourceHash String?
  catalogReviewedAt   DateTime?
  providerFetchedAt   DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([published, prepared])
}

// Generic translations keep the canonical public content untouched.
model ContentTranslation {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  field        String
  sourceLocale String
  targetLocale String
  sourceHash   String
  contextHash  String
  value        String
  origin       String   @default("machine")
  status       String   @default("draft")
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([entityType, entityId, field, targetLocale])
  @@index([targetLocale, status])
  @@index([entityType, entityId, status])
}

// A unique revision/context key deduplicates workers and bounded retries.
model TranslationJob {
  id           String   @id @default(cuid())
  dedupeKey    String   @unique
  entityType   String
  entityId     String
  field        String
  sourceLocale String
  targetLocale String
  sourceHash   String
  contextHash  String
  status       String   @default("queued")
  attempts     Int      @default(0)
  characters   Int      @default(0)
  lastError    String?
  lockedAt     DateTime?
  nextAttemptAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([targetLocale, createdAt])
}

model RateLimitBucket {
  keyDigest String   @id
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

/**
 * Archived historical exchange quotes retained for audit provenance.
 * The USD-only runtime never reads, refreshes, or converts using this table.
 */
model ExchangeRate {
  id           String   @id @default(cuid())
  baseCurrency String
  currency     String
  rate         Decimal  @db.Decimal(20, 10)
  fetchedAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([baseCurrency, currency])
  @@index([baseCurrency])
}

/**
 * ==========================================================================
 * Catalog
 * ==========================================================================
 * Category is hierarchical:
 * - parentId = null: root/main category
 * - parentId != null: subcategory
 * - children can themselves have children for unlimited nesting
 * path and depth are denormalized navigation fields maintained by the
 * catalog service whenever a category is created, renamed, or moved.
 */

model Category {
  id              String         @id @default(cuid())
  name            String
  slug            String
  path            String         @unique
  description     String?
  image           String?
  seoTitle        String?
  metaDescription String?
  ogImage         String?
  status          CategoryStatus @default(ACTIVE)
  position        Int            @default(0)
  depth           Int            @default(0)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  products Product[]
  banners  Banner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, slug])
  @@index([parentId, status, position])
  @@index([status, depth, position])
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

model Brand {
  id              String      @id @default(cuid())
  name            String      @unique
  slug            String      @unique
  description     String?
  logo            String?
  website         String?
  seoTitle        String?
  metaDescription String?
  ogImage         String?
  status          BrandStatus @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, name])
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

model Manufacturer {
  id          String             @id @default(cuid())
  name        String             @unique
  slug        String             @unique
  description String?
  logo        String?
  website     String?
  country     String?
  status      ManufacturerStatus @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, name])
}

enum ManufacturerStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id              String           @id @default(cuid())
  productCode     String           @unique
  name            String
  slug            String           @unique
  description     String?
  seoTitle        String?
  metaDescription String?
  ogImage         String?
  gtin            String?
  itemCondition   ProductCondition @default(NEW)
  status          ProductStatus    @default(ACTIVE)

  modelNumber String?
  series      String?

  buyingPrice   Decimal  @db.Decimal(12, 2)
  salePrice     Decimal  @db.Decimal(12, 2)
  discountPrice Decimal? @db.Decimal(12, 2)

  // Flexible technical data for industrial products.
  // Add a PostgreSQL GIN index through the provided SQL migration.
  specifications Json? @db.JsonB

  // Structured block-based product description builder output.
  // Each element is a discriminated-union block (richText, featureGrid,
  // imageText, specificationTable). The legacy `description` field is
  // used as a plain-text fallback when this column is absent or empty.
  descriptionBlocks Json? @db.JsonB

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)

  variants              ProductVariant[]
  images                ProductImage[]
  capitalCostSelections AdminProductCost?
  wishlists             Wishlist[]
  orderItems            OrderItem[]
  reviews               Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, status, createdAt])
  @@index([brandId, status, createdAt])
  @@index([manufacturerId, status, createdAt])
  @@index([status, createdAt])
  @@index([categoryId, status, salePrice])
  @@index([specifications], type: Gin)
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

/**
 * Permanent catalog URL history. This intentionally has no foreign key:
 * redirect records must remain usable after an entity is unpublished or
 * deleted, and entityId is retained for auditing and targeted invalidation.
 */
model CatalogRedirect {
  id              String                    @id @default(cuid())
  sourcePath      String                    @unique
  destinationPath String
  entityType      CatalogRedirectEntityType
  entityId        String
  permanent       Boolean                   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destinationPath])
  @@index([entityType, entityId])
}

enum CatalogRedirectEntityType {
  PRODUCT
  CATEGORY
  BRAND
}

/**
 * A generic purchasable product option.
 * variantKey must be generated deterministically from option values, e.g.
 * "voltage=220v|phase=single" or "default" for a non-variable product.
 * This avoids hard-coding the catalog to only size and color.
 */
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantKey  String  @default("default")
  name        String?
  size        String?
  color       String?
  modelNumber String?
  sku         String? @unique
  stock       Int     @default(0)
  image       String?
  attributes  Json?   @db.JsonB

  isActive Boolean @default(true)

  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, variantKey])
  @@index([productId, isActive])
  @@index([isActive, stock])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  alt      String?
  position Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId, position])
}

/**
 * ==========================================================================
 * Cart & wishlist
 * ==========================================================================
 */

model CartItem {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Product is intentionally derived through variant.product.
  // This removes duplicated productId data and prevents mismatched rows.
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, variantId])
  @@index([variantId])
}

model Wishlist {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

/**
 * ==========================================================================
 * Orders
 * ==========================================================================
 */

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  guestCustomerId String?
  guestCustomer   GuestCustomer? @relation(fields: [guestCustomerId], references: [id], onDelete: Restrict)
  // Only digests are persisted; bearer credentials never enter order JSON.
  guestAccessTokenHash String?
  checkoutKey         String? @unique
  checkoutFingerprint String?

  items OrderItem[]

  subtotal              Decimal   @db.Decimal(12, 2)
  deliveryCharge        Decimal   @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount             Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal   @db.Decimal(12, 2)
  advancePayment        Decimal   @default(0) @db.Decimal(12, 2)
  // Existing amount columns and `currency` remain the canonical settlement
  // snapshot used by accounting and payment integrations. Display fields are
  // an immutable customer-facing FX snapshot captured when the order is made.
  currency              String    @default("USD")
  baseCurrency          String    @default("USD")
  displayCurrency       String    @default("USD")
  displaySubtotal       Decimal   @db.Decimal(12, 2)
  displayDeliveryCharge Decimal   @default(0) @db.Decimal(12, 2)
  displayDiscountAmount Decimal   @default(0) @db.Decimal(12, 2)
  displayTaxAmount      Decimal   @default(0) @db.Decimal(12, 2)
  displayTotalAmount    Decimal   @db.Decimal(12, 2)
  displayAdvancePayment Decimal   @default(0) @db.Decimal(12, 2)
  exchangeRate          Decimal   @default(1) @db.Decimal(20, 10)
  exchangeRateAt        DateTime?

  customerName       String
  customerPhone      String
  customerAddress    String
  customerEmail      String?
  customerCity       String?
  customerArea       String?
  customerPostalCode String?
  customerNote       String?

  promoCode String?

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(AIRWALLEX)
  paymentStatus PaymentStatus @default(UNPAID)

  payments        PaymentTransaction[]
  promoCodeUsages PromoCodeUsage[]
  statusHistory   OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([guestCustomerId, createdAt])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([paymentMethod, paymentStatus, createdAt])
}

// A checkout contact record, never an authenticated account. Each successful
// guest order gets its own profile; contacts are deliberately not unique.
model GuestCustomer {
  id         String @id @default(cuid())
  fullName   String
  phone      String
  email      String?
  address    String
  city       String?
  postalCode String?
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  PAYMENT_CONFIRMED
  SELLER_TO_PACK
  PACKED
  READY_TO_SHIP
  WAREHOUSE
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  updatedBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  ONLINE
  SSLCOMMERZ
  AIRWALLEX
  PAYPAL
}

enum PaymentStatus {
  PAID
  UNPAID
  PENDING
  FAILED
  REFUNDED
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName       String
  productImage      String?
  sku               String?
  variantName       String?
  color             String?
  size              String?
  variantAttributes Json?    @db.JsonB
  quantity          Int
  unitPrice         Decimal  @db.Decimal(12, 2)
  totalPrice        Decimal  @db.Decimal(12, 2)
  displayUnitPrice  Decimal  @db.Decimal(12, 2)
  displayTotalPrice Decimal  @db.Decimal(12, 2)
  buyingPrice       Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId, createdAt])
  @@index([variantId])
}

/**
 * ==========================================================================
 * Reviews
 * ==========================================================================
 */

model Review {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  authorName String
  rating     Int
  title      String?
  comment    String?

  source   ReviewSource @default(CUSTOMER)
  verified Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, createdAt])
  @@index([productId, rating])
}

enum ReviewSource {
  CUSTOMER
  ADMIN
}

/**
 * ==========================================================================
 * Testimonials
 * ==========================================================================
 */

model Testimonial {
  id       String            @id @default(cuid())
  name     String
  location String?
  image    String?
  rating   Int               @default(5)
  text     String
  position Int               @default(0)
  status   TestimonialStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, position, createdAt])
}

enum TestimonialStatus {
  ACTIVE
  INACTIVE
}

/**
 * ==========================================================================
 * Promo codes
 * ==========================================================================
 */

model PromoCode {
  id           String            @id @default(cuid())
  code         String            @unique
  description  String?
  discountType PromoDiscountType @default(FLAT)
  value        Decimal           @db.Decimal(12, 2)
  minOrder     Decimal?          @db.Decimal(12, 2)
  maxDiscount  Decimal?          @db.Decimal(12, 2)
  startsAt     DateTime?
  endsAt       DateTime?
  usageLimit   Int?
  usedCount    Int               @default(0)
  status       PromoCodeStatus   @default(ACTIVE)

  usages PromoCodeUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endsAt])
}

enum PromoDiscountType {
  FLAT
  PERCENT
}

enum PromoCodeStatus {
  ACTIVE
  INACTIVE
}

model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  usedAt DateTime @default(now())

  @@unique([promoCodeId, orderId])
  @@index([userId, usedAt])
  @@index([orderId])
}

/**
 * ==========================================================================
 * Store settings
 * ==========================================================================
 */

model StoreSettings {
  id                    String  @id @default(cuid())
  taxRate               Decimal @default(0.05) @db.Decimal(5, 4)
  standardShippingFee   Decimal @default(0) @db.Decimal(12, 2)
  freeShippingThreshold Decimal @default(0) @db.Decimal(12, 2)
  expressShippingFee    Decimal @default(0) @db.Decimal(12, 2)
  currency              String  @default("USD")
  // Set only after an explicit review/repricing of all current monetary data.
  pricingCurrencyVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ==========================================================================
 * Contact, addresses, payments & inventory
 * ==========================================================================
 */

model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String
  message String

  status ContactMessageStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName   String
  phone      String
  city       String
  area       String?
  address    String
  postalCode String?
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDefault])
}

model PaymentTransaction {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider                  String
  transactionId             String?
  idempotencyKey            String?
  gatewayUrl                String?
  gatewaySessionKey         String?
  validationId              String?
  bankTransactionId         String?
  cardType                  String?
  riskLevel                 Int?
  amount                    Decimal                  @db.Decimal(12, 2)
  currency                  String                   @default("USD")
  baseAmount                Decimal?                 @db.Decimal(12, 2)
  baseCurrency              String?
  exchangeRate              Decimal?                 @db.Decimal(20, 10)
  exchangeRateAt            DateTime?
  status                    PaymentTransactionStatus @default(PENDING)
  providerStatus            String?
  failureCode               String?
  failureMessage            String?
  rawResponse               Json?                    @db.JsonB
  paidAt                    DateTime?
  requiresReview            Boolean                  @default(false)
  reviewReason              String?
  reviewResolvedAt          DateTime?
  reviewResolvedBy          String?
  reviewResolution          String?
  reviewResolutionReference String?
  lastReconciledAt          DateTime?
  reconciliationResult      String?
  reconciliationAttempts    Int                      @default(0)

  airwallexWebhookEvents AirwallexWebhookEvent[]
  events                 PaymentTransactionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, transactionId])
  @@unique([provider, idempotencyKey])
  @@unique([provider, gatewaySessionKey])
  @@unique([provider, validationId])
  @@unique([provider, bankTransactionId])
  @@index([orderId, createdAt])
  @@index([createdAt, id])
  @@index([status, createdAt])
  @@index([provider, status, createdAt])
  @@index([provider, status, updatedAt])
  @@index([provider, requiresReview, createdAt])
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  EXPIRED
  CREATED
  REQUIRES_PAYMENT_METHOD
  PENDING_REVIEW
  PROCESSING
  REQUIRES_REVIEW
}

enum AirwallexEventProcessingStatus {
  PENDING
  PROCESSING
  RETRY_PENDING
  PROCESSED
  REQUIRES_REVIEW
}

model AirwallexWebhookEvent {
  id              String  @id @default(cuid())
  eventId         String  @unique
  eventName       String
  paymentIntentId String
  accountId       String?
  apiVersion      String?

  receivedAt         DateTime                       @default(now())
  processingStatus   AirwallexEventProcessingStatus @default(PENDING)
  processingAttempts Int                            @default(0)
  sanitizedPayload   Json                           @db.JsonB
  processedAt        DateTime?
  processingError    String?
  nextAttemptAt      DateTime                       @default(now())
  lockedAt           DateTime?
  lockToken          String?

  paymentTransactionId String?
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@index([processingStatus, nextAttemptAt, receivedAt], map: "AirwallexEvent_claimable_idx")
  @@index([processingStatus, lockedAt], map: "AirwallexEvent_stale_claim_idx")
  @@index([paymentIntentId, receivedAt], map: "AirwallexEvent_intent_received_idx")
  @@index([paymentTransactionId, receivedAt], map: "AirwallexEvent_attempt_received_idx")
}

enum PaymentTransactionEventSource {
  INITIATION
  WEBHOOK
  RECONCILIATION
  MANUAL
}

model PaymentTransactionEvent {
  id                   String                        @id @default(cuid())
  paymentTransactionId String
  paymentTransaction   PaymentTransaction            @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  source               PaymentTransactionEventSource
  eventName            String
  fromStatus           PaymentTransactionStatus?
  toStatus             PaymentTransactionStatus
  providerStatus       String?
  providerEventId      String?
  reasonCode           String?
  requiresReview       Boolean                       @default(false)
  createdAt            DateTime                      @default(now())

  @@index([paymentTransactionId, createdAt], map: "PaymentTransactionEvent_attempt_created_idx")
  @@index([providerEventId], map: "PaymentTransactionEvent_provider_event_idx")
}

model InventoryLog {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  type     InventoryLogType
  quantity Int
  note     String?

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([type, createdAt])
}

enum InventoryLogType {
  STOCK_IN
  STOCK_OUT
  ORDER_PLACED
  ORDER_CANCELLED
  RETURNED
  MANUAL_ADJUSTMENT
}

/**
 * ==========================================================================
 * Banners
 * ==========================================================================
 */

model Banner {
  id          String       @id @default(cuid())
  type        BannerType
  title       String?
  subtitle    String?
  description String?
  image       String?
  link        String?
  position    Int          @default(0)
  status      BannerStatus @default(ACTIVE)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  metadata Json? @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, position])
  @@index([categoryId, status, position])
}

enum BannerType {
  CAROUSEL
  CATEGORY
  TOP
  DEAL
  PROMO
}

enum BannerStatus {
  ACTIVE
  INACTIVE
}

/**
 * ==========================================================================
 * Capital & cost tracking
 * ==========================================================================
 */

model AdminCapital {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(14, 2)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  currency String @default("USD")

}

model AdminProductCost {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId])
  @@index([createdAt])
}

model AdminOtherCost {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(14, 2)
  reason      String
  description String?
  costDate    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([costDate])
  @@index([reason, costDate])
  currency String @default("USD")

}

enum CapitalCostActivityType {
  CAPITAL_SET
  CAPITAL_UPDATED
  CAPITAL_ADDED
  PRODUCT_COST_ADDED
  PRODUCT_COST_REMOVED
  COST_CREATED
  COST_UPDATED
  COST_DELETED
}

model AdminCapitalCostActivity {
  id          String                  @id @default(cuid())
  type        CapitalCostActivityType
  description String
  amount      Decimal?                @db.Decimal(14, 2)
  note        String?
  entityId    String?
  actorId     String?
  actorName   String?
  actorEmail  String?
  createdAt   DateTime                @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([actorId, createdAt])
  currency String @default("USD")

}

model AdminActivityLog {
  id       String  @id @default(cuid())
  kind     String
  action   String
  target   String?
  targetId String?
  href     String?

  actorId    String?
  actorName  String?
  actorEmail String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([actorId, createdAt])
}
