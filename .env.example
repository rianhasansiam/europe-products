# SexToy canonical configuration. Never commit real credentials.
NODE_ENV=development
SITE_URL=https://sextoybd.net
NEXT_PUBLIC_SITE_URL=https://sextoybd.net
AUTH_URL=https://sextoybd.net
DATABASE_URL=
# DIRECT_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
UPLOAD_STORAGE=filesystem
UPLOAD_DIR=/var/lib/sextoy/uploads
UPLOAD_PUBLIC_URL=https://sextoybd.net/uploads
MAX_UPLOAD_SIZE_MB=5
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
CUSTOMER_INFO_CHECKER_API=
NEXT_PUBLIC_META_PIXEL_ID=
META_PURCHASE_DIAGNOSTICS=false
NEXT_PUBLIC_META_PURCHASE_DIAGNOSTICS=false
# Catalog and checkout use USD, fixed in lib/currency/config.ts.
AIRWALLEX_ENABLED=false
AIRWALLEX_ENV=sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_RECONCILIATION_SECRET=
AIRWALLEX_SANDBOX_API_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_PRODUCTION_API_BASE_URL=https://api.airwallex.com
AIRWALLEX_HTTP_TIMEOUT_MS=10000
AIRWALLEX_WEBHOOK_TOLERANCE_SECONDS=300
AIRWALLEX_RETURN_URL=https://sextoybd.net/orders/payment-return
# Optional translation generation; bundled catalogs do not require this service.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_TIMEOUT_MS=10000
LIBRETRANSLATE_BATCH_SIZE=20
LIBRETRANSLATE_MAX_CHARACTERS=50000
TRANSLATION_PROTECTED_TERMS=SexToy
TRANSLATION_CONCURRENCY=1
TRANSLATION_BATCH_LIMIT=10
TRANSLATION_CHARACTER_LIMIT=50000
